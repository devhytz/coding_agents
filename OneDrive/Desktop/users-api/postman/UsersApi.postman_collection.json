{
  "info": {
    "name": "Users API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Pruebas de integración de la API de usuarios (blog). Requiere la app en ejecución y la variable baseUrl. Los datos usan {{$timestamp}} para ser repetibles."
  },
  "item": [
    {
      "name": "Users",
      "item": [
        {
          "name": "Crear usuario (happy path)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde HTTP 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('Devuelve el usuario sin password_hash', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property('id');",
                  "    pm.expect(body).to.have.property('username');",
                  "    pm.expect(body).to.have.property('email');",
                  "    pm.expect(body).to.not.have.property('password');",
                  "    pm.expect(body).to.not.have.property('password_hash');",
                  "});",
                  "pm.environment.set('userId', pm.response.json().id);",
                  "pm.collectionVariables.set('dupEmail', pm.response.json().email);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"user_{{$timestamp}}\",\n  \"email\": \"user_{{$timestamp}}@example.com\",\n  \"password\": \"secret123\",\n  \"full_name\": \"Usuario de Prueba\"\n}"
            },
            "url": "{{baseUrl}}/api/users"
          }
        },
        {
          "name": "Crear usuario con email duplicado (409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde HTTP 409', function () { pm.response.to.have.status(409); });",
                  "pm.test('Devuelve un mensaje de error', function () {",
                  "    pm.expect(pm.response.json()).to.have.property('error');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"otro_{{$timestamp}}\",\n  \"email\": \"{{dupEmail}}\",\n  \"password\": \"secret123\"\n}"
            },
            "url": "{{baseUrl}}/api/users"
          }
        },
        {
          "name": "Crear usuario con datos inválidos (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde HTTP 400', function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"x\"\n}"
            },
            "url": "{{baseUrl}}/api/users"
          }
        },
        {
          "name": "Listar usuarios (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Devuelve un arreglo', function () {",
                  "    pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/users"
          }
        },
        {
          "name": "Obtener usuario por id (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('El id coincide con el creado', function () {",
                  "    pm.expect(String(pm.response.json().id)).to.eql(String(pm.environment.get('userId')));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/users/{{userId}}"
          }
        },
        {
          "name": "Obtener usuario inexistente (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde HTTP 404', function () { pm.response.to.have.status(404); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/users/999999999"
          }
        },
        {
          "name": "Reemplazar usuario PUT (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('El full_name fue actualizado', function () {",
                  "    pm.expect(pm.response.json().full_name).to.eql('Usuario Reemplazado');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"put_{{$timestamp}}\",\n  \"email\": \"put_{{$timestamp}}@example.com\",\n  \"password\": \"secret123\",\n  \"full_name\": \"Usuario Reemplazado\"\n}"
            },
            "url": "{{baseUrl}}/api/users/{{userId}}"
          }
        },
        {
          "name": "Reemplazar usuario inexistente (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde HTTP 404', function () { pm.response.to.have.status(404); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"ghost_{{$timestamp}}\",\n  \"email\": \"ghost_{{$timestamp}}@example.com\",\n  \"password\": \"secret123\"\n}"
            },
            "url": "{{baseUrl}}/api/users/999999999"
          }
        },
        {
          "name": "Actualizar parcialmente PATCH (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('El full_name fue actualizado', function () {",
                  "    pm.expect(pm.response.json().full_name).to.eql('Usuario Parchado');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Usuario Parchado\"\n}"
            },
            "url": "{{baseUrl}}/api/users/{{userId}}"
          }
        },
        {
          "name": "PATCH con cuerpo vacío (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde HTTP 400', function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": "{{baseUrl}}/api/users/{{userId}}"
          }
        },
        {
          "name": "PATCH usuario inexistente (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde HTTP 404', function () { pm.response.to.have.status(404); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Nadie\"\n}"
            },
            "url": "{{baseUrl}}/api/users/999999999"
          }
        },
        {
          "name": "Eliminar usuario (204)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde HTTP 204', function () { pm.response.to.have.status(204); });"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/users/{{userId}}"
          }
        },
        {
          "name": "Eliminar usuario ya eliminado (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde HTTP 404', function () { pm.response.to.have.status(404); });"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/users/{{userId}}"
          }
        }
      ]
    }
  ]
}
